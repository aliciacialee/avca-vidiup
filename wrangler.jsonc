{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avca-vidiup",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * D1 Database (SQLite)
	 * 建立指令：wrangler d1 create vidiup-db
	 * 建立後把 database_id 填入下方
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vidiup-db",
			"database_id": "ecdcb581-5e11-4fcf-ad86-1f910abd6f79",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * R2 Object Storage
	 * 建立指令：wrangler r2 bucket create vidiup-media
	 */
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "vidiup-media"
		}
	]
}